{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Backend (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/RealEstateAPI/bin/Debug/net9.0/RealEstateAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/RealEstateAPI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5010;https://localhost:7002"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Frontend (React)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/real-estate-frontend/node_modules/.bin/react-scripts",
      "args": ["start"],
      "cwd": "${workspaceFolder}/real-estate-frontend",
      "env": {
        "BROWSER": "none"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Launch Full Stack",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "start-fullstack",
      "program": "${workspaceFolder}/RealEstateAPI/bin/Debug/net9.0/RealEstateAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/RealEstateAPI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5010;https://localhost:7002"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ],
  "compounds": [
    {
      "name": "Backend + Frontend",
      "configurations": ["Launch Backend (.NET)", "Launch Frontend (React)"]
    }
  ]
}
